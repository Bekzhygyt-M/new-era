# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ignore every .env variant, keep the committed template
.env
.env.*
.env.local
.env.production
.env.development
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database, session secret and uploaded media — never commit user data
/data
/private
/public/uploads

# nested duplicate repository
/NewEra/

# one-off diagnostic output from past debugging sessions (logs and scratch
# dumps written to the project root). Ignored, never deleted — remove the
# rule if you ever need to keep one as an attachment.
/build-lint.log
/test-errors.log
/err.txt
/full_err.txt
/m_out.txt
/tmp_tsc_err.txt
/ts_err_clean.txt
/ts_err_full.txt
/tsc-output.txt
/tsc_all.txt
/tsc_output.txt
/tsc_output_utf8.txt
/git_diff_full.patch