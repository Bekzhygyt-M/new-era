# ── Session (required) ───────────────────────────────────────────────────────
# At least 32 characters. Generate one with: npm run gen:secret
# In production the server refuses to start without it.
SESSION_SECRET=

# ── Database & storage ───────────────────────────────────────────────────────
# With a service-role key set, the app uses Supabase for both data and uploads.
# Without one it falls back to the local JSON store — fine for development, but
# NOT for a serverless host: that filesystem is wiped on every redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides: 'local' or 'supabase'. Leave unset to auto-detect.
# DATABASE_DRIVER=
# STORAGE_DRIVER=

# ── Telegram private channel access (optional) ────────────────────────────────
# Grants buyers of Standard Trading / Pro Trading access to the matching private
# channel. Until all three are set the feature stays inactive: approvals still
# work normally and no channel button is shown.
#
# NEVER put the bot token in a NEXT_PUBLIC_* variable — those are shipped to the
# browser. Enter the real values only in the hosting provider's environment.
TELEGRAM_BOT_TOKEN=
# Channel id or @username of the Standard Trading private channel.
TELEGRAM_STANDARD_CHANNEL_ID=
# Channel id or @username of the Pro Trading private channel.
TELEGRAM_PRO_CHANNEL_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Absolute origin used in certificate links and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Master admin account (defaults to admin@gmail.com).
ADMIN_EMAIL=
